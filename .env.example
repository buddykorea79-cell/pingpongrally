# Supabase 프로젝트 설정 → API 에서 복사합니다.
# 두 값이 비어 있으면 앱은 '데모 모드'(브라우저 안에서만 동작)로 실행됩니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile 사이트 키(선택). 교육생 익명 입장·참석자 등록에 봇 확인을 붙입니다. 비워 두면 CAPTCHA 없이 들어옵니다.
# Supabase Auth → Attack Protection 에서 같은 위젯의 비밀 키를 등록해야 합니다.
VITE_TURNSTILE_SITE_KEY=

# 동의 문안·개인정보 처리 안내에 표시할 저장 위치
VITE_STORAGE_LOCATION=Supabase(서울 리전)

# 개인정보 처리방침·이용약관에 표시할 운영자(개인정보 보호책임자) 이름과 문의 메일(선택)
# 비워 두면 'PingPongRally 운영자'와 GitHub 문의 게시판이 표시됩니다.
VITE_OPERATOR_NAME=
VITE_OPERATOR_EMAIL=
